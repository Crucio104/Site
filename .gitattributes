# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.dart text
*.py text
*.gradle text
*.json text
*.yaml text
*.yml text
*.xml text
*.md text
*.txt text
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.pdf binary
*.ez binary
*.bz2 binary
*.swp binary
*.jar binary
*.so binary
*.dylib binary
*.dll binary
