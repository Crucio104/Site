import flet as ft


def main(page: ft.Page):
    page.title = "Background diviso"
    page.padding = 0
    page.spacing = 0
    page.window.maximized = True
    page.window.alignment = ft.alignment.center
    page.bgcolor = ft.Colors.GREY_400

    def build_ui_pc():
        # desktop-oriented layout; computes sizes from current page width
        w = page.width or 1200
        is_mobile = w < 700
        LM = 50 if not is_mobile else 16
        LM_LG = 80 if not is_mobile else 24
        RM = int(max(16, w * 0.05))
        IMG_H = int(min(300, max(120, w * 0.25)))
        H1 = 40 if not is_mobile else 28
        H2 = 30 if not is_mobile else 18
        P = 18 if not is_mobile else 14
        TOP_OFFSET = int(max(60, w * 0.12)) if not is_mobile else int(max(20, w * 0.06))
        PROFILE_TOP = int(TOP_OFFSET * 0.35)

        black_circle = ft.Container(width=7, height=7, bgcolor=ft.Colors.BLACK, border_radius=7 / 2)

        header_row = ft.Row(
            spacing=20,
            controls=[
                ft.Container(
                    content=ft.Image(
                        src="Profile Image.png",
                        border_radius=ft.border_radius.all(15),
                        fit=ft.ImageFit.CONTAIN,
                        height=IMG_H,
                    ),
                    margin=ft.margin.only(bottom=10, left=LM),
                ),
                ft.Column(
                    controls=[
                        ft.Container(
                            content=ft.Text("ALESSIO CURCIO", size=H1, weight=ft.FontWeight.BOLD, color=ft.Colors.BLACK),
                            margin=ft.margin.only(top=TOP_OFFSET, left=LM),
                            expand=6,
                        ),
                        ft.Container(
                            content=ft.Text("University student", size=H2, weight=ft.FontWeight.BOLD, color=ft.Colors.GREY_700),
                            margin=ft.margin.only(left=LM),
                            expand=4,
                        ),
                    ],
                    spacing=0,
                ),
                ft.Container(
                    content=ft.Column(
                        controls=[
                            ft.Row(
                                controls=[
                                    ft.Container(content=ft.Image("Profile.png", height=50, width=50, fit=ft.ImageFit.CONTAIN), margin=ft.margin.only(left=LM_LG, top=PROFILE_TOP)),
                                    ft.Container(content=ft.Text("Profile", color=ft.Colors.BLACK, size=30, weight=ft.FontWeight.BOLD), margin=ft.margin.only(top=PROFILE_TOP)),
                                ]
                            ),
                            ft.Container(
                                content=ft.Text(
                                    "Hi, I’m Alessio and I'm currently a 3rd year student at the Sapienza University of Rome in the Faculty of Applied Computer Science and Artificial Intelligence (ACSAI).",
                                    color=ft.Colors.GREY_700,
                                    size=22 if not is_mobile else 14,
                                    weight=getattr(ft.FontWeight, "W_600", ft.FontWeight.BOLD),
                                    text_align=ft.TextAlign.LEFT,
                                ),
                                expand=1,
                                margin=ft.margin.only(left=LM_LG, right=RM, top=10),
                            ),
                            ft.Container(
                                bgcolor="#deb887",
                                content=ft.TextButton(
                                    "Download CV",
                                    icon="Download",
                                    style=ft.ButtonStyle(color=ft.Colors.BLACK, text_style=ft.TextStyle(weight=ft.FontWeight.BOLD, size=20)),
                                    on_click=lambda e: page.launch_url("Alessio Curcio CV.pdf"),
                                ),
                                border_radius=ft.border_radius.all(13),
                                padding=ft.padding.all(3),
                                alignment=ft.alignment.bottom_right,
                                margin=ft.margin.only(right=100, top=50),
                                expand=1,
                            ),
                        ]
                    ),
                    margin=ft.margin.only(left=LM, top=int(TOP_OFFSET * 0.2), bottom=int(TOP_OFFSET * 0.4)),
                    expand=1,
                ),
            ],
        )

        header = ft.Container(content=header_row, bgcolor="#deb887", border_radius=ft.border_radius.only(top_left=30, top_right=30), expand=3)

        # Body content (simplified but matching PC layout)
        body = ft.Column(
            controls=[
                ft.Container(content=ft.Text("Skills / Experiences", size=P + 12, weight=ft.FontWeight.BOLD, color=ft.Colors.BLACK), margin=ft.margin.only(left=LM, top=40), bgcolor="#deb887", border_radius=ft.border_radius.all(10)),
                ft.Container(content=ft.Text("Education", size=P + 8, weight=ft.FontWeight.BOLD), margin=ft.margin.only(left=LM)),
                ft.Column(controls=[
                    ft.Container(content=ft.Row(controls=[black_circle, ft.Container(content=ft.Text("Graduated from Liceo Scientifico...", size=P + 2), expand=1)]), margin=ft.margin.only(left=LM, right=RM)),
                    ft.Container(content=ft.Row(controls=[black_circle, ft.Container(content=ft.Text("Currently pursuing a Bachelor's degree...", size=P + 2), expand=1)]), margin=ft.margin.only(left=LM, right=RM)),
                ]),
                ft.Container(content=ft.Text("Projects / Activities", size=25, weight=ft.FontWeight.BOLD), margin=ft.margin.only(left=LM, top=20)),
                ft.Container(content=ft.Text("Activities in association with IBM, Ericsson...", size=18, color=ft.Colors.GREY_700), margin=ft.margin.only(left=LM), expand=1),
                ft.Container(content=ft.Text("GENERAL INFO", size=30, weight=ft.FontWeight.BOLD), bgcolor="#deb887", margin=ft.margin.only(left=50, top=20), border_radius=ft.border_radius.all(10)),
                ft.Container(content=ft.Row(controls=[ft.Image("Home.png", height=45), ft.Text("  Rome, Ciampino", size=18)]), margin=ft.margin.only(left=LM, top=20)),
            ],
            spacing=8,
        )

        content = ft.Column(controls=[header, ft.Container(content=body, bgcolor=ft.Colors.WHITE, border_radius=ft.border_radius.only(bottom_left=30, bottom_right=30), expand=7)], spacing=-1)

        frame = ft.Container(
            bgcolor=ft.Colors.BLACK,
            border_radius=ft.border_radius.all(40),
            padding=ft.padding.all(8),
            alignment=ft.alignment.center,
            content=ft.Container(content=content, bgcolor=None),
            margin=ft.margin.only(top=30, bottom=30, right=30, left=30),
            shadow=ft.BoxShadow(blur_radius=10, color=ft.Colors.BLACK, offset=ft.Offset(0, 0)),
        )

        # Put frame centered in a horizontally scrollable row when needed
        return ft.ListView(controls=[ft.Row(controls=[frame], scroll=ft.ScrollMode.AUTO)], expand=True)

    def build_ui_mobile():
        # Return the same UI as desktop for visual parity
        return build_ui_pc()

    def on_resize(e):
        try:
            while page.controls:
                page.controls.pop()
        except Exception:
            pass
        # mobile threshold is 1200 (user preference)
        if page.width is None:
            page.add(build_ui_pc())
        elif page.width < 1200:
            page.add(build_ui_mobile())
        else:
            page.add(build_ui_pc())
        page.update()

    page.on_resized = on_resize

    # initial build
    if page.width is None:
        page.add(build_ui_pc())
    elif page.width < 1200:
        page.add(build_ui_mobile())
    else:
        page.add(build_ui_pc())


if __name__ == "__main__":
    ft.app(target=main)
